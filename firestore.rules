rules_version = '2';

// Firestore-Regeln für „Lebensspuren":
// Jeder angemeldete Nutzer darf ausschließlich seine eigenen Daten
// unter /users/{eigene UID}/... lesen und schreiben. Alles andere ist gesperrt.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
