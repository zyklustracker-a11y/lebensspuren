rules_version = '2';

// Cloud-Storage-Regeln für „Lebensspuren":
// Mediendateien liegen unter /users/{UID}/media/... –
// nur der angemeldete Besitzer darf seine eigenen Dateien lesen und schreiben.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
